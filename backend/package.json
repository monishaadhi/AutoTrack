{
  "name": "autotrack-backend",
  "version": "1.0.0",
  "description": "Backend API for Automotive Production Monitoring Dashboard",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
